{% comment %} By Shopify Partner ak44sh - High-Performance Brutalist Theme {% endcomment %}
{%- comment -%}
  Cart Item Snippet — Heggee
  Line item with image, details, quantity controls, and remove button.
  Receives `item` variable (a line_item from cart.items).
{%- endcomment -%}

<div class="cart-item" data-line-key="{{ item.key }}">

  {%- comment -%} Image {%- endcomment -%}
  <a href="{{ item.url }}" class="cart-item__image">
    {%- if item.image != blank -%}
      <img
        src="{{ item.image | image_url: width: 200 }}"
        alt="{{ item.title | escape }}"
        width="200"
        height="200"
        loading="lazy"
      >
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
  </a>

  {%- comment -%} Details {%- endcomment -%}
  <div class="cart-item__details">
    <h3 class="cart-item__title">
      <a href="{{ item.url }}">{{ item.product.title }}</a>
    </h3>

    {%- unless item.variant.title == 'Default Title' -%}
      <p class="cart-item__variant">{{ item.variant.title }}</p>
    {%- endunless -%}

    <p class="cart-item__price">₹{{ item.final_line_price | money_without_currency }}</p>

    {%- comment -%} Quantity Selector {%- endcomment -%}
    <div class="quantity-selector cart-item__quantity">
      <button class="quantity-selector__btn" data-action="minus" aria-label="Decrease quantity">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="4" y1="8" x2="12" y2="8"/>
        </svg>
      </button>
      <input
        type="number"
        class="quantity-selector__input"
        value="{{ item.quantity }}"
        min="1"
        max="99"
        data-line-key="{{ item.key }}"
        aria-label="Quantity"
        id="cart-qty-{{ item.key }}"
      >
      <button class="quantity-selector__btn" data-action="plus" aria-label="Increase quantity">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="8" y1="4" x2="8" y2="12"/>
          <line x1="4" y1="8" x2="12" y2="8"/>
        </svg>
      </button>
    </div>
  </div>

  {%- comment -%} Actions {%- endcomment -%}
  <div class="cart-item__actions">
    <button class="cart-item__remove" data-line-key="{{ item.key }}" aria-label="Remove {{ item.title | escape }}">
      Remove
    </button>
  </div>

</div>
