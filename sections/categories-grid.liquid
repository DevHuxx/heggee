{% comment %} By Shopify Partner ak44sh - High-Performance Brutalist Theme {% endcomment %}
<section class="categories-grid">
  <div class="categories-grid__inner">
    {%- for block in section.blocks -%}
      <div class="category-tile" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 1200 }}"
            alt="{{ block.settings.title | escape }}"
            class="category-tile__image"
            loading="lazy"
            width="1200"
            height="auto"
          >
        {%- else -%}
          <div style="background:var(--color-muted);width:100%;height:100%;"></div>
        {%- endif -%}
        <div class="category-tile__overlay">
          <a href="{{ block.settings.link | default: '/collections/all' }}" class="category-tile__label">
            {{ block.settings.title | default: 'Category' }}
          </a>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Categories Grid",
  "settings": [],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Outerwear" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{
    "name": "Categories Grid",
    "blocks": [
      { "type": "category", "settings": { "title": "Outerwear" } },
      { "type": "category", "settings": { "title": "Essentials" } }
    ]
  }]
}
{% endschema %}
