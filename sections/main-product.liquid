{% comment %} By Shopify Partner ak44sh - High-Performance Brutalist Theme {% endcomment %}
<div class="product-page">
  <div class="container" style="padding-top:2rem;padding-bottom:4rem;">

    {%- comment -%} Breadcrumb {%- endcomment -%}
    <nav class="breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="breadcrumb__sep">/</span>
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      <span class="breadcrumb__sep">/</span>
      <span>{{ product.title }}</span>
    </nav>

    <div class="product-layout">

      {%- comment -%} Gallery {%- endcomment -%}
      <div>
        <div class="product-gallery__main" id="product-main-image">
          {%- if product.featured_image != blank -%}
            <img
              src="{{ product.featured_image | image_url: width: 1200 }}"
              alt="{{ product.featured_image.alt | escape | default: product.title }}"
              id="main-product-img"
              width="1200"
              height="auto"
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="product-gallery__thumbs">
            {%- for image in product.images -%}
              <button
                class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                data-image-url="{{ image | image_url: width: 1200 }}"
                onclick="document.getElementById('main-product-img').src=this.dataset.imageUrl;document.querySelectorAll('.product-gallery__thumb').forEach(t=>t.classList.remove('is-active'));this.classList.add('is-active');"
              >
                <img width="800" height="auto" src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | escape }}" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Product Info {%- endcomment -%}
      <div class="product-info">

        {%- comment -%} Badges {%- endcomment -%}
        {%- if product.tags contains 'new' -%}
          <span class="product-info__badge product-info__badge--new">New</span>
        {%- endif -%}
        {%- if product.compare_at_price > product.price -%}
          <span class="product-info__badge product-info__badge--sale">Sale</span>
        {%- endif -%}

        <p class="product-info__category">{{ product.type }}</p>
        <h1 class="product-info__title">{{ product.title }}</h1>

        <div class="product-info__price">
          <span class="product-info__price-current">₹{{ product.price | money_without_currency }}</span>
          {%- if product.compare_at_price > product.price -%}
            <span class="product-info__price-compare">₹{{ product.compare_at_price | money_without_currency }}</span>
            {%- assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
            <span class="product-info__price-badge">{{ discount }}% OFF</span>
          {%- endif -%}
        </div>

        {%- if product.description != blank -%}
          <div class="product-info__description">{{ product.description }}</div>
        {%- endif -%}

        {%- comment -%} Add to Cart Form {%- endcomment -%}
        {%- form 'product', product, id: 'product-form', data-product-form: '' -%}

          {%- comment -%} Variant Selector {%- endcomment -%}
          {%- for option in product.options_with_values -%}
            <div class="product-form__group">
              <label class="product-form__label">{{ option.name }}</label>

              {%- if option.name == 'Color' or option.name == 'Colour' -%}
                <div class="color-swatches">
                  {%- for value in option.values -%}
                    <button
                      type="button"
                      class="color-swatch{% if option.selected_value == value %} is-active{% endif %}"
                      data-option-name="{{ option.name }}"
                      data-option-value="{{ value }}"
                      title="{{ value }}"
                      style="background-color: {{ value | handleize }};"
                      onclick="this.closest('.color-swatches').querySelectorAll('.color-swatch').forEach(s=>s.classList.remove('is-active'));this.classList.add('is-active');"
                    >
                      {%- if option.selected_value == value -%}
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                      {%- endif -%}
                    </button>
                  {%- endfor -%}
                </div>
              {%- else -%}
                <div class="size-buttons">
                  {%- for value in option.values -%}
                    <button
                      type="button"
                      class="size-btn{% if option.selected_value == value %} is-active{% endif %}"
                      data-option-name="{{ option.name }}"
                      data-option-value="{{ value }}"
                      onclick="this.closest('.size-buttons').querySelectorAll('.size-btn').forEach(s=>s.classList.remove('is-active'));this.classList.add('is-active');"
                    >
                      {{ value }}
                    </button>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}

          {%- comment -%} Variant ID {%- endcomment -%}
          <select name="id" id="variant-selector" style="display:none;" aria-label="Product variant">
            {%- for variant in product.variants -%}
              <option
                value="{{ variant.id }}"
                {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                {% unless variant.available %}disabled{% endunless %}
              >
                {{ variant.title }} — ₹{{ variant.price | money_without_currency }}
              </option>
            {%- endfor -%}
          </select>

          {%- comment -%} Quantity {%- endcomment -%}
          <div class="product-form__group">
            <label class="product-form__label">Quantity</label>
            <div class="quantity-selector">
              <button type="button" class="quantity-selector__btn" onclick="var i=this.nextElementSibling;i.value=Math.max(1,parseInt(i.value)-1);" aria-label="Decrease quantity">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
              <input type="number" name="quantity" class="quantity-selector__input" value="1" min="1">
              <button type="button" class="quantity-selector__btn" onclick="var i=this.previousElementSibling;i.value=parseInt(i.value)+1;" aria-label="Increase quantity">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
            </div>
          </div>

          {%- comment -%} Actions {%- endcomment -%}
          <div class="product-actions">
            <button
              type="submit"
              class="btn-primary product-actions__add"
              {% unless product.available %}disabled{% endunless %}
            >
              {%- if product.available -%}Add to Bag{%- else -%}Sold Out{%- endif -%}
            </button>
          </div>
        {%- endform -%}

        {%- comment -%} Third-Party App Blocks Hook (Shiprocket, Reviews, etc) {%- endcomment -%}
        {%- if section.blocks.size > 0 -%}
          <div class="product-apps">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when '@app' -%}
                  {% render block %}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%} Trust Features {%- endcomment -%}
        <div class="trust-features">
          <div class="trust-feature">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M5 18H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3.19M15 6h2a2 2 0 0 1 2 2H1v2a2 2 0 0 1-2 2H15"/><path d="M14 6V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v2"/><line x1="12" y1="11" x2="12" y2="15"/></svg>
            <p class="trust-feature__title">Free Shipping</p>
            <p class="trust-feature__subtitle">Above ₹25,000</p>
          </div>
          <div class="trust-feature">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
            <p class="trust-feature__title">Easy Returns</p>
            <p class="trust-feature__subtitle">30 Days</p>
          </div>
          <div class="trust-feature">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <p class="trust-feature__title">Secure</p>
            <p class="trust-feature__subtitle">Payment</p>
          </div>
        </div>

        {%- comment -%} Details {%- endcomment -%}
        <div class="product-details">
          <div class="product-details__group">
            <h3 class="product-details__heading">Details</h3>
            <ul class="product-details__list">
              <li>Premium quality materials</li>
              <li>Ethically sourced and produced</li>
              <li>Designed with care</li>
            </ul>
          </div>
          <div class="product-details__group">
            <h3 class="product-details__heading">Shipping & Returns</h3>
            <p class="product-details__text">Free shipping on orders over ₹25,000. Easy returns within 30 days.</p>
          </div>
        </div>

      </div>
    </div>

    {%- comment -%} Related Products {%- endcomment -%}
    {%- if collection != blank -%}
      {%- assign related = collection.products | where: 'available' -%}
      {%- if related.size > 1 -%}
        <section style="margin-top:5rem;">
          <h2 style="font-size:var(--text-2xl);text-align:center;margin-bottom:3rem;">You May Also Like</h2>
          <div class="product-grid">
            {%- for item in collection.products limit: 4 -%}
              {%- if item.id != product.id -%}
                <div class="reveal">
                  {%- render 'product-card', product: item -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </section>
      {%- endif -%}
    {%- endif -%}

  </div>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | json }},
  "image": {{ product.featured_image | image_url: width: 1200 | json }},
  "offers": {
    "@type": "Offer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ product.price | divided_by: 100.0 | json }},
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
  }
}
</script>

{% schema %}
{
  "name": "Product Information",
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
