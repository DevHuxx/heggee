{% comment %} By Shopify Partner ak44sh - High-Performance Brutalist Theme {% endcomment %}
<footer class="site-footer">

  {%- comment -%} Newsletter in footer {%- endcomment -%}
  <div class="footer-newsletter">
    <div class="container">
      <div class="footer-newsletter__inner">
        <p class="luxury-subheading" style="color:rgba(255,255,255,0.6);margin-bottom:1rem;">Newsletter</p>
        <h3 class="footer-newsletter__title">Join our world</h3>
        <p class="footer-newsletter__text">
          Subscribe to receive exclusive access to new collections, private sales, and curated content.
        </p>
        {%- form 'customer', id: 'footer-newsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="footer-newsletter__form">
            <input
              type="email"
              name="contact[email]"
              class="footer-newsletter__input"
              placeholder="Enter your email"
              required
              autocomplete="email"
            >
            <button type="submit" class="footer-newsletter__btn">Subscribe</button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>

  {%- comment -%} Links {%- endcomment -%}
  <div class="container">
    <div class="footer-grid">

      <div>
        <div class="footer-brand__logo">{{ settings.logo_text | default: 'HEGGEE' }}</div>
        <p class="footer-brand__text">
          {{ section.settings.brand_description | default: 'Timeless elegance meets contemporary design. Crafted with intention, worn with purpose.' }}
        </p>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div {{ block.shopify_attributes }}>
            <h4 class="footer-col__title">{{ block.settings.heading }}</h4>
            <nav>
              {%- for link in block.settings.menu.links -%}
                <a href="{{ link.url }}" class="footer-col__link">{{ link.title }}</a>
              {%- endfor -%}
            </nav>
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>

    <div class="footer-bottom">
      <p class="footer-bottom__copy">© {{ 'now' | date: '%Y' }} HEGGEE. All rights reserved.</p>
      <div class="footer-bottom__links">
        <a href="/policies/privacy-policy" class="footer-bottom__link">Privacy Policy</a>
        <a href="/policies/terms-of-service" class="footer-bottom__link">Terms of Service</a>
      </div>
    </div>
  </div>

  {%- comment -%} Mobile Bottom Glass Nav {%- endcomment -%}
  <nav class="glass-bottom-nav">
    <div class="container" style="padding:0">
      <div class="glass-bottom-nav__inner">
        <a href="{{ routes.root_url }}" class="glass-nav-item">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <span>Shop</span>
        </a>
        <a href="{{ routes.all_products_collection_url }}" class="glass-nav-item">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          <span>Explore</span>
        </a>
        <a href="{{ routes.cart_url }}" class="glass-nav-item">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <span>Bag</span>
        </a>
        <a href="{{ routes.account_url }}" class="glass-nav-item">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span>Account</span>
        </a>
      </div>
    </div>
  </nav>

</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "brand_description", "label": "Brand Description", "default": "Timeless elegance meets contemporary design. Crafted with intention, worn with purpose." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu Column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "max_blocks": 4,
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop" } },
      { "type": "menu", "settings": { "heading": "Help" } },
      { "type": "menu", "settings": { "heading": "About" } }
    ]
  }
}
{% endschema %}
