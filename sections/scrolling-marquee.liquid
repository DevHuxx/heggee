{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    overflow: hidden;
  }
  .marquee-wrapper-{{ section.id }} {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
    {% if section.settings.border_top %}border-top: 1px solid var(--color-border);{% endif %}
    {% if section.settings.border_bottom %}border-bottom: 1px solid var(--color-border);{% endif %}
  }
  .marquee-content-{{ section.id }} {
    display: flex;
    font-family: var(--font-heading);
    font-size: {{ section.settings.font_size }}rem;
    text-transform: uppercase;
    animation: marquee {{ section.settings.speed }}s linear infinite;
  }
  .marquee-item {
    padding: 0 2rem;
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  <div class="marquee-wrapper-{{ section.id }}">
    <div class="marquee-content-{{ section.id }}">
      {%- for i in (1..10) -%}
        <span class="marquee-item">{{ section.settings.text }}</span>
      {%- endfor -%}
    </div>
    <div class="marquee-content-{{ section.id }}" aria-hidden="true">
      {%- for i in (1..10) -%}
        <span class="marquee-item">{{ section.settings.text }}</span>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Scrolling Marquee",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "NEW ARRIVALS • SHOP NOW •"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "unit": "rem",
      "label": "Font Size",
      "default": 3.0
    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 50,
      "step": 1,
      "unit": "s",
      "label": "Animation Speed",
      "default": 15
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Show Top Border",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "border_bottom",
      "label": "Show Bottom Border",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Scrolling Marquee"
    }
  ]
}
{% endschema %}
