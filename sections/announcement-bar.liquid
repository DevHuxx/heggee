{%- if section.settings.show_announcement -%}
  <div class="announcement-bar" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; text-align: center; padding: 10px; font-weight: 500; font-size: var(--text-sm); letter-spacing: var(--tracking-wide);">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" style="color: inherit; text-decoration: none;">
    {%- endif -%}
    {{ section.settings.text }}
    {%- if section.settings.link != blank -%}
      </a>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "FREE WORLDWIDE SHIPPING ON ALL ORDERS OVER ₹5,000"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}
