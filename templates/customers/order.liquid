{% comment %} By Shopify Partner ak44sh - High-Performance Brutalist Theme {% endcomment %}
<div class="container" style="padding-top:calc(2rem + 6rem);padding-bottom:4rem;">
  <div style="margin-bottom:3rem;border-bottom:1px solid var(--color-border);padding-bottom:1rem;">
    <h1 style="font-size:var(--text-4xl);">Order {{ order.name }}</h1>
    <a href="{{ routes.account_url }}" style="color:var(--color-muted-fg);font-size:var(--text-sm);text-transform:uppercase;letter-spacing:var(--tracking-widest);margin-top:0.5rem;display:inline-block;">← {{ 'customer.orders.return_to_account' | t }}</a>
    <p style="color:var(--color-muted-fg);margin-top:1rem;font-size:var(--text-sm);">Placed on {{ order.created_at | time_tag: format: 'date_at_time' }}</p>
  </div>

  <div style="display:grid;gap:4rem;" class="order-grid">
    <div>
      <table style="width:100%;text-align:left;border-collapse:collapse;font-size:var(--text-sm);">
        <thead>
          <tr style="border-bottom:1px solid var(--color-border);">
            <th style="padding:1rem 0;font-family:var(--font-heading);text-transform:uppercase;letter-spacing:var(--tracking-widest);">Product</th>
            <th style="padding:1rem 0;font-family:var(--font-heading);text-transform:uppercase;letter-spacing:var(--tracking-widest);">Price</th>
            <th style="padding:1rem 0;font-family:var(--font-heading);text-transform:uppercase;letter-spacing:var(--tracking-widest);">Quantity</th>
            <th style="padding:1rem 0;font-family:var(--font-heading);text-transform:uppercase;letter-spacing:var(--tracking-widest);text-align:right;">{{ 'customer.orders.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for line_item in order.line_items -%}
            <tr style="border-bottom:1px solid var(--color-border-light);">
              <td style="padding:1rem 0;">
                <div style="display:flex;align-items:center;gap:1rem;">
                  {%- if line_item.image -%}
                    <img width="800" height="auto" src="{{ line_item.image | image_url: width: 100 }}" alt="{{ line_item.title }}" style="width:60px;height:80px;object-fit:cover;background:var(--color-muted);">
                  {%- endif -%}
                  <div>
                    <a href="{{ line_item.url }}" style="font-weight:700;">{{ line_item.product.title }}</a>
                    {%- unless line_item.product.has_only_default_variant -%}
                      <p style="color:var(--color-muted-fg);font-size:var(--text-xs);margin-top:0.25rem;">{{ line_item.variant.title }}</p>
                    {%- endunless -%}
                  </div>
                </div>
              </td>
              <td style="padding:1rem 0;color:var(--color-muted-fg);">₹{{ line_item.original_price | money_without_currency }}</td>
              <td style="padding:1rem 0;color:var(--color-muted-fg);">{{ line_item.quantity }}</td>
              <td style="padding:1rem 0;font-weight:700;text-align:right;">₹{{ line_item.final_line_price | money_without_currency }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot>
          <tr>
            <td colspan="3" style="padding:1rem 0;color:var(--color-muted-fg);">{{ 'cart.general.subtotal' | t }}</td>
            <td style="padding:1rem 0;text-align:right;font-weight:500;">₹{{ order.line_items_subtotal_price | money_without_currency }}</td>
          </tr>
          {%- for shipping_method in order.shipping_methods -%}
            <tr>
              <td colspan="3" style="padding:0.5rem 0;color:var(--color-muted-fg);">Shipping ({{ shipping_method.title }})</td>
              <td style="padding:0.5rem 0;text-align:right;font-weight:500;">₹{{ shipping_method.price | money_without_currency }}</td>
            </tr>
          {%- endfor -%}
          {%- for tax_line in order.tax_lines -%}
            <tr>
              <td colspan="3" style="padding:0.5rem 0;color:var(--color-muted-fg);">Tax ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</td>
              <td style="padding:0.5rem 0;text-align:right;font-weight:500;">₹{{ tax_line.price | money_without_currency }}</td>
            </tr>
          {%- endfor -%}
          <tr style="border-top:2px solid var(--color-border);">
            <td colspan="3" style="padding:1rem 0;font-family:var(--font-heading);font-size:var(--text-lg);text-transform:uppercase;letter-spacing:var(--tracking-widest);">{{ 'customer.orders.total' | t }}</td>
            <td style="padding:1rem 0;font-family:var(--font-heading);font-size:var(--text-lg);text-align:right;">₹{{ order.total_price | money_without_currency }}</td>
          </tr>
        </tfoot>
      </table>
    </div>

    <div>
      <div style="background:var(--color-muted);padding:2rem;border:1px solid var(--color-border);margin-bottom:2rem;">
        <h3 style="font-size:var(--text-xl);margin-bottom:1rem;text-transform:uppercase;letter-spacing:var(--tracking-widest);">Billing Address</h3>
        <p style="font-size:var(--text-xs);font-weight:700;text-transform:uppercase;letter-spacing:var(--tracking-widest);margin-bottom:0.5rem;">{{ 'customer.orders.payment_status' | t }}: {{ order.financial_status_label }}</p>
        <div style="color:var(--color-muted-fg);font-size:var(--text-sm);line-height:1.6;">
          {{ order.billing_address | format_address }}
        </div>
      </div>

      <div style="background:var(--color-muted);padding:2rem;border:1px solid var(--color-border);">
        <h3 style="font-size:var(--text-xl);margin-bottom:1rem;text-transform:uppercase;letter-spacing:var(--tracking-widest);">Shipping Address</h3>
        <p style="font-size:var(--text-xs);font-weight:700;text-transform:uppercase;letter-spacing:var(--tracking-widest);margin-bottom:0.5rem;">{{ 'customer.orders.fulfillment_status' | t }}: {{ order.fulfillment_status_label }}</p>
        <div style="color:var(--color-muted-fg);font-size:var(--text-sm);line-height:1.6;">
          {{ order.shipping_address | format_address }}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
@media(min-width: 1024px){
  .order-grid { grid-template-columns: 1fr 350px; }
}
</style>
